# ============================================================
#  FreeFire Hub Bot — Environment Variables
#  Copy to .env and fill the real values:  cp .env.example .env
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
# One admin id, or several separated by commas (e.g. 707967792,8192967759)
ADMIN_ID=707967792
LOG_CHAT_ID=-1001546889015
# Channels that receive every new listing are managed in the admin panel:
# «📢 مدیریت کانال‌ها ← 📣 کانال‌های تبلیغ» (no env var needed).
# Chat opened by the green «✅ خرید» button under a new-listing announcement (@ optional)
LISTING_BUY_USERNAME=ffshah_bot

# --- MySQL ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=freefire
MYSQL_PASSWORD=change_me_strong_password
MYSQL_DATABASE=freefire_hub
MYSQL_ROOT_PASSWORD=change_me_root_password
# SSL mode for backup/restore (mysqldump/mysql). Keep DISABLED for the internal
# Docker network; set to PREFERRED/REQUIRED only if the DB enforces TLS.
MYSQL_SSL_MODE=DISABLED

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Onboarding verification (Iranian mobile + math captcha) ---
CAPTCHA_TTL_SECONDS=300          # how long one captcha challenge stays valid
CAPTCHA_MAX_ATTEMPTS=3           # wrong answers allowed before a short cooldown
CAPTCHA_COOLDOWN_SECONDS=60      # cooldown length after too many wrong answers

# --- Business rules ---
# Paid once the invited user finishes verification (phone + captcha), not at /start.
REFERRAL_REWARD=10000            # Toman added to referrer wallet per verified invite
REQUESTED_ACCOUNT_DEPOSIT=300000 # Toman deposit for a requested account
CARD_NUMBER=6037-9911-2222-3333  # bank card shown to user for payment
CARD_HOLDER=Saeed Example

# --- Runtime ---
DEBUG=false
TIMEZONE=Asia/Tehran
RATE_LIMIT_PER_SECOND=1          # max messages/second per user (anti-spam)
